#!/bin/sh
# Fake "cosign verify" for test/installer/run.sh: it models what the updater relies on, not the
# cryptography (that is cosign's job). State in $FAKE:
#   tag.<tag>          digest the tag resolves to
#   sig.<digest>       one signature per line: "SAN ISSUER WORKFLOW_REPOSITORY"
#   tampered.<digest>  signatures exist but do not verify
#   registry-down      the registry or Sigstore is unreachable
#   two-digests        output claims two different digests
#   move-tag-to        after verifying, the tag is moved to the digest in this file
# Like cosign, a certificate is accepted when its SAN matches the identity regexp and issuer and
# workflow repository are equal to the expected ones.
set -eu
echo "cosign $*" >>"$FAKE/calls"
[ "${1:-}" = verify ] || { echo "Error: fake cosign supports only verify" >&2; exit 2; }
shift
re="" iss="" repo="" ref=""
while [ $# -gt 0 ]; do
	case $1 in
	--certificate-identity-regexp) re=$2; shift 2 ;;
	--certificate-oidc-issuer) iss=$2; shift 2 ;;
	--certificate-github-workflow-repository) repo=$2; shift 2 ;;
	--output) shift 2 ;;
	-*) echo "Error: unknown flag $1" >&2; exit 2 ;;
	*) ref=$1; shift ;;
	esac
done
[ -n "$re" ] && [ -n "$iss" ] || { echo "Error: --certificate-identity and --certificate-oidc-issuer are required for keyless" >&2; exit 2; }
if [ -f "$FAKE/registry-down" ]; then
	echo "Error: GET https://ghcr.io/v2/: dial tcp: lookup ghcr.io: no such host" >&2
	exit 1
fi
case $ref in
*@sha256:*) d=${ref#*@} ;;
*) d=$(cat "$FAKE/tag.${ref##*:}" 2>/dev/null) || { echo "Error: MANIFEST_UNKNOWN: manifest unknown" >&2; exit 1; } ;;
esac
if [ ! -s "$FAKE/sig.$d" ]; then
	echo "Error: no signatures found" >&2
	exit 10
fi
if [ -f "$FAKE/tampered.$d" ]; then
	echo "Error: no matching signatures: crypto/ecdsa: verification error" >&2
	exit 1
fi
ok=no
while read -r san siss srepo; do
	if printf '%s\n' "$san" | grep -Eq -- "$re" && [ "$siss" = "$iss" ] && { [ -z "$repo" ] || [ "$srepo" = "$repo" ]; }; then
		ok=yes
	fi
done <"$FAKE/sig.$d"
if [ $ok != yes ]; then
	echo "Error: no matching signatures: none of the expected identities matched what was in the certificate" >&2
	exit 1
fi
echo "Verification for $ref --" >&2
out="{\"critical\":{\"identity\":{\"docker-reference\":\"${ref%%[:@]*}\"},\"image\":{\"docker-manifest-digest\":\"$d\"},\"type\":\"https://sigstore.dev/cosign/sign/v1\"},\"optional\":{}}"
if [ -f "$FAKE/two-digests" ]; then
	other=sha256:$(printf '%064d' 7)
	out="$out,{\"critical\":{\"identity\":{\"docker-reference\":\"x\"},\"image\":{\"docker-manifest-digest\":\"$other\"},\"type\":\"x\"},\"optional\":{}}"
fi
echo "[$out]"
if [ -f "$FAKE/move-tag-to" ]; then
	cp "$FAKE/move-tag-to" "$FAKE/tag.${ref##*:}"
fi
