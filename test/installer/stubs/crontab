#!/bin/sh
# Fake crontab for test/installer/run.sh: the table is $FAKE/crontab.
set -eu
case ${1:-} in
-l) [ -f "$FAKE/crontab" ] || { echo "no crontab for $(id -un)" >&2; exit 1; }; cat "$FAKE/crontab" ;;
-r) rm -f "$FAKE/crontab" ;;
-) cat >"$FAKE/crontab" ;;
*) echo "fake crontab: unsupported $*" >&2; exit 2 ;;
esac
